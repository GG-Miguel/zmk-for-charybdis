#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <220>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <220>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/* Spanish QWERTY notes:
 * - SEMICOLON  -> ñ  (Ñ with Shift)
 * - LS(COMMA)  -> ;
 * - LS(DOT)    -> :
 * - LS(GRAVE)  -> >
 * - RA(E)      -> €
 */

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE       &kp N1   &kp N2  &kp N3        &kp N4        &kp N5          &kp N6       &kp N7         &kp N8     &kp N9   &kp N0       &kp BACKSLASH
&kp ESC         &kp Q    &kp W   &kp E         &kp R         &kp T           &kp Y        &kp U          &kp I      &kp O    &kp P        &kp BACKSPACE
&kp TAB         &mt LCTRL A  &mt LALT S  &mt LGUI D  &mt LSHFT F  &kp G        &kp H       &mt RSHFT J   &mt RGUI K  &mt RALT L  &mt RCTRL SEMI  &kp APOS
 &kp LCTRL       &lt 3 Z  &kp X   &kp C         &kp V         &kp B           &kp N        &kp M          &kp COMMA  &kp DOT  &lt 3 SLASH  &kp RIGHT_ALT
                                  &kp BACKSPACE  &kp SPACE     &lt 1 ENTER     &lt 2 ENTER  &kp ESCAPE
                                                &kp LEFT_ALT  &kp LEFT_WIN    &kp DELETE
            >;
        };

        Lower {
            bindings = <
&kp TILDE       &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR      &kp PERCENT     &kp CARET      &kp AMPERSAND    &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp GRAVE       &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4    &kp NUMBER_5    &kp NUMBER_6   &kp NUMBER_7     &kp NUMBER_8    &kp NUMBER_9           &kp NUMBER_0           &kp BACKSLASH
&kp LBKT        &kp RBKT         &kp LBRC      &kp RBRC      &kp LS(COMMA)  &kp LS(DOT)      &kp MINUS     &kp EQUAL        &kp UNDERSCORE  &kp PLUS               &kp LS(GRAVE)          &kp RA(E)
&kp SEMICOLON   &kp APOS         &kp COMMA     &kp DOT       &kp SLASH       &kp QUESTION    &kp LEFT      &kp DOWN         &kp UP          &kp RIGHT              &kp PAGE_UP            &kp PAGE_DOWN
                                           &kp BACKSPACE  &kp SPACE     &trans         &trans         &kp ESCAPE
                                                         &kp LEFT_ALT   &kp LEFT_WIN   &kp DELETE
            >;
        };

        Raise {
            bindings = <
&kp F12        &kp F1      &kp F2      &kp F3         &kp F4         &kp F5          &kp F6             &kp F7         &kp F8    &kp F9     &kp F10  &kp F11
&kp LS(GRAVE)  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)     &kp LS(LBKT)    &kp LS(RBKT)       &none          &none     &none      &none    &none
&kp LSHFT      &kp LS(N5)  &kp LS(N6)  &kp LS(N7)     &kp LS(N8)     &none           &kp LS(BACKSLASH)  &none          &kp UP    &none      &none    &none
&kp LCTRL      &kp LS(N9)  &kp LS(N0)  &kp LS(MINUS)  &kp LS(EQUAL)  &none           &none              &kp LEFT       &kp DOWN  &kp RIGHT  &none    &none
                                       &kp BACKSPACE  &kp SPACE      &trans          &trans             &kp ESCAPE
                                                      &kp LEFT_ALT   &kp LEFT_WIN    &kp DELETE
            >;
        };

        Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none           &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR      &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &mkp LCLK     &mkp MCLK     &mkp RCLK     &none      &none         &none           &mkp LCLK  &mkp MCLK     &mkp RCLK     &none         &none
&bootloader  &none         &none         &none         &none      &none         &studio_unlock  &none      &none         &none         &none         &bootloader
                                         &kp BACKSPACE  &kp SPACE  &mo 4         &mo 4           &kp ESCAPE
                                                       &kp LEFT_ALT &kp LEFT_WIN  &kp DELETE
            >;
        };

        Scroll {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &mkp LCLK     &mkp MCLK     &mkp RCLK     &none      &none         &none       &mkp LCLK  &mkp MCLK     &mkp RCLK     &none         &none
&bootloader  &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &bootloader
                                         &kp BACKSPACE  &kp SPACE  &trans        &trans      &kp ESCAPE
                                                       &kp LEFT_ALT &kp LEFT_WIN  &kp DELETE
            >;
        };
    };
};
