#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};


/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

       QWERTY {
            bindings = <
&kp GRAVE       &kp N1   &kp N2  &kp N3        &kp N4        &kp N5          &kp N6       &kp N7         &kp N8     &kp N9   &kp N0       &kp APOS
&kp TAB         &kp Q    &kp W   &kp E         &kp R         &kp T           &kp Y        &kp U          &kp I      &kp O    &kp P        &kp SLASH
&kp LSHFT   &mt LGUI A  &mt LALT S &mt LSHFT D   &mt LCTRL F         &kp G           &kp H         &mt RCTRL J          &mt RSHFT K        &mt RALT L     &mt RGUI SEMICOLON     &kp APOS
&kp LCTRL       &kp Z  &kp X   &kp C         &kp V         &kp B           &kp N        &kp M          &kp COMMA  &kp DOT  &kp MINUS  &kp BACKSLASH
                               &kp ESCAPE    &kp BACKSPACE   &kp SPACE       &lt 2 ENTER &kp LALT
                                               &lt 1 TAB       &kp CAPSLOCK    &kp DELETE
            >;
        };

        Symbol {
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp HASH      &kp DOLLAR    &kp DOLLAR    &kp PERCENT    &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp LPAR  &kp RPAR  &kp PIPE
&kp GRAVE  &kp MINUS     &kp PLUS  &kp N3  &kp N4  &kp LBKT       &kp RBKT       &kp F1         &kp F2        &kp F3                &kp F4                 &kp BACKSPACE
&kp LSHFT  &kp N5     &kp N6  &kp N7  &kp N8  &none          &kp LBRCE   &kp F5         &kp F6        &kp F7                &kp F8                 &kp PAGE_UP
&kp LCTRL  &kp N9     &kp N0  &kp MINUS     &kp EQUAL     &none          &kp RBRCE          &kp F9         &kp F10       &kp F11               &kp F12                &kp PAGE_DOWN
                                          &none  &none    &trans         &kp ENTER      &kp RALT
                                                        &none         &none          &none
            >;
        };

        Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none       &mkp LCLK      &mkp MCLK     &mkp RCLK         &none         &none
&bootloader  &trans        &mkp RCLK     &mkp MCLK        &mkp LCLK  &none         &none       &none  &none        &none     &trans        &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &none         &none
            >;
        };

    };
};
